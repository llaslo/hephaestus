# Copy to .env.local and fill in. Never commit .env.local.

# --- Database ---
DATABASE_URL=postgres://hephaestus:hephaestus@127.0.0.1:5432/hephaestus

# --- Anthropic ---
# Use a dedicated API workspace with a spend limit.
ANTHROPIC_API_KEY=
# Created by `pnpm --filter @hephaestus/worker setup:managed` and printed to the console.
MANAGED_ENVIRONMENT_ID=

# --- GitHub App ---
GITHUB_APP_ID=
# Path to the App's private key (.pem). Keep it outside the repo.
GITHUB_APP_PRIVATE_KEY_PATH=
# Repos to watch, comma-separated owner/name. The App must be installed on each.
HEPH_REPOS=llaslo/hephaestus-sandbox

# --- Factory behaviour ---
# Label that marks an issue as approved for agents.
HEPH_APPROVED_LABEL=factory:approved
HEPH_POLL_SECONDS=60
# Default runtime: managed | local
HEPH_DEFAULT_RUNTIME=managed
# Parallel local container operations.
LOCAL_RUNNER_SLOTS=2
LOCAL_RUNNER_IMAGE=hephaestus-runner
# Hard daily spend cap in USD; the dispatcher pauses when it is reached.
HEPH_DAILY_BUDGET_USD=5

# --- Telemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
