{
  "name": "hephaestus",
  "private": true,
  "description": "Agentic software factory: Claude agent teams that turn requirements into tested, reviewed, merged code.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @hephaestus/core db:generate",
    "db:migrate": "pnpm --filter @hephaestus/core db:migrate",
    "db:seed": "pnpm --filter @hephaestus/core db:seed",
    "runner:build": "docker build -t hephaestus-runner -f packages/runner/Dockerfile ."
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.9.0"
  }
}
